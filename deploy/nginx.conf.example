# Example nginx + PHP-FPM site (adjust paths, server_name, certificates and the fastcgi socket).
server {
    listen 443 ssl http2;
    server_name portal.example.org;
    ssl_certificate     /etc/letsencrypt/live/portal.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/portal.example.org/privkey.pem;

    root /var/www/iha/public;
    index index.php;

    location / {
        try_files $uri /index.php$is_args$args;
    }
    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;   # everything goes through the front controller
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }
    location ~ /\.(?!well-known) { deny all; }
}
server {
    listen 80;
    server_name portal.example.org;
    return 301 https://$host$request_uri;
}
