APP_ENV=local
APP_URL=http://localhost:8080
APP_KEY=change-me-to-a-long-random-string

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=iha_portal
DB_USER=iha_app
DB_PASSWORD=change-me
DB_SSLMODE=prefer

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="IHA Portal"

# Stage 3
# MAIL_DRIVER=log writes emails (including verification links) to storage/logs/mail.log for local testing.
# Use MAIL_DRIVER=smtp (and fill the SMTP_* values above) for real email. Never use "log" in production.
MAIL_DRIVER=log

# Shown on the landing page when set
SUPPORT_EMAIL=
SUPPORT_PHONE=

# Stage 5b: QR codes
# APP_KEY must be a long random secret (at least 32 characters) before QR codes can be issued. Generate one with:
#   php -r "echo bin2hex(random_bytes(32));"
# Public verification page: what to show besides the Student ID (1 = show, 0 = hide)
QR_PUBLIC_SHOW_NAME=1
QR_PUBLIC_SHOW_SCHOOL=1

# Backups (bin/backup.php). PG_DUMP_PATH is only needed when pg_dump is not on the PATH (typical on Windows).
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\16\bin\pg_dump.exe
# BACKUP_DIR=
BACKUP_KEEP_DAYS=30
QR_EVENT_KEEP_DAYS=180

# Hosting on a platform without a shared disk (for example Vercel):
# SESSION_DRIVER=database          keeps logins in PostgreSQL instead of local files (run bin/migrate.php first)
# TRUSTED_IP_HEADER=X-Forwarded-For  only behind a proxy that sets and overwrites it; otherwise leave unset
# CRON_SECRET=<16+ random characters>  protects /cron/cleanup
